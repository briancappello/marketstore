root_directory: data
listen_port: 5993
grpc_listen_port: 5995
log_level: info
stop_grace_period: 5
wal_rotate_interval: 5
timezone: "America/New_York"

# attrgroup_types defines schema templates for attribute groups.
# When a bucket is created with a matching attrgroup name (e.g., AAPL/1Min/OHLCV),
# the configured schema is used as the default. This ensures consistent data types
# across all buckets of the same type.
#
# Behavior:
# - Columns defined here use the configured types
# - Extra columns from feeders are kept with their inferred types (with a warning)
# - If a feeder sends a column with an incompatible type, an error is raised
# - record_type can be "fixed" (default) or "variable"
#
# Supported column types:
#   float32, float64, int16, int32, int64,
#   uint8, uint16, uint32, uint64, byte, bool, string16
#
attrgroup_types:
  OHLCV:
    columns:
      Open: float32
      High: float32
      Low: float32
      Close: float32
      Volume: int64
    record_type: fixed

  # TRADE - Individual trade executions (used by massive plugin)
  # Full trade data with exchange, tape ID, and up to 4 condition codes
  TRADE:
    columns:
      Nanoseconds: int32
      Price: float64
      Size: uint64
      Exchange: byte
      TapeID: byte
      Cond1: byte
      Cond2: byte
      Cond3: byte
      Cond4: byte
    record_type: variable

  QUOTE:
    columns:
      Nanoseconds: int32
      BidPrice: float64
      AskPrice: float64
      BidSize: uint64
      AskSize: uint64
    record_type: variable

triggers:
  - module: stream.so
    on: "*/1Sec/*"
    config:
      filter: "nasdaq"

  - module: stream.so
    on: "*/1Min/*"
    config:
      filter: "nasdaq"

  # Stage 1: TRADE -> 1Sec OHLCV bars
  - module: ondiskagg.so
    on: "*/1Sec/TRADE"
    config:
      destinations:
        - 1Sec

  # Stage 2: 1Sec -> 1Min OHLCV bars
  - module: ondiskagg.so
    on: "*/1Sec/OHLCV"
    config:
      destinations:
        - 1Min

  # Stage 3: 1Min -> 1D OHLCV bars
  - module: ondiskagg.so
    on: "*/1Min/OHLCV"
    config:
      destinations:
        - 1D

bgworkers:
  - name: StreamReplay
    module: streamreplay.so

  - module: massive.so
    name: Massive
    config:
      api_key: "FIXME"
      base_url: "https://api.massive.com"
      ws_server: "wss://socket.massive.com"  # "wss://delayed.massive.com/stocks" | "ws://127.0.0.1:8765"
      # ws_data_types controls real-time WebSocket streaming.
      ws_data_types:
        - quotes
        - trades
        - 1Sec
        - 1Min  # default if none specified
      symbols:
        - AAPL
        - SPY
      symbols_dsn: "postgres://FIXME_USER:FIXME_PW@127.0.0.1:5432/fin?sslmode=disable"
      symbols_query: "SELECT id, ticker, listed FROM asset WHERE is_active = TRUE AND delisted IS NULL"

      # query_start controls backfill independently of streaming.
      # Keys can be quotes, trades, or timeframes (eg 1Min, 5Min, 1H, 1D)
      query_start:
#        quotes: "2024-01-01"
#        trades: "2024-01-01"
        1Min: "2024-01-01"
        1D: "2024-01-01"
      backfill_batch_size: 50000
      backfill_adjusted: true

      # sync_queries tracks backfill coverage in PostgreSQL so the backfiller
      # knows exactly what has already been fetched from the API. Each key must
      # match a key in query_start. Queries use $1 = asset_id (the id column
      # from symbols_query) and $2 = timestamp.
      #
      # The read query must return two nullable TIMESTAMPTZ columns: (oldest, newest).
      # Together they define the confirmed sync window [oldest, newest]:
      #   - If newest >= latest market close: forward backfill is skipped.
      #   - If oldest <= query_start: backward backfill is skipped.
      #   - If query_start is moved earlier: the gap from query_start to oldest is backfilled.
      #
      # The write queries use LEAST/GREATEST with COALESCE to handle the initial
      # NULL case and to ensure the window only expands, never shrinks.
      #
      # This example uses the fin database schema (asset_data_vendor table).
      # You can use any schema — the plugin only executes these SQL strings.
      sync_queries:
        1Min:
          read: >
            SELECT minutely_oldest, minutely_newest
            FROM asset_data_vendor
            WHERE asset_id = $1 AND data_vendor_id = (SELECT id FROM data_vendor WHERE key = 'massive')
          write_oldest: >
            UPDATE asset_data_vendor
            SET minutely_oldest = COALESCE(LEAST(minutely_oldest, $2), $2)
            WHERE asset_id = $1 AND data_vendor_id = (SELECT id FROM data_vendor WHERE key = 'massive')
          write_newest: >
            UPDATE asset_data_vendor
            SET minutely_newest = COALESCE(GREATEST(minutely_newest, $2), $2)
            WHERE asset_id = $1 AND data_vendor_id = (SELECT id FROM data_vendor WHERE key = 'massive')
        1D:
          read: >
            SELECT daily_oldest, daily_newest
            FROM asset_data_vendor
            WHERE asset_id = $1 AND data_vendor_id = (SELECT id FROM data_vendor WHERE key = 'massive')
          write_oldest: >
            UPDATE asset_data_vendor
            SET daily_oldest = COALESCE(LEAST(daily_oldest, $2), $2)
            WHERE asset_id = $1 AND data_vendor_id = (SELECT id FROM data_vendor WHERE key = 'massive')
          write_newest: >
            UPDATE asset_data_vendor
            SET daily_newest = COALESCE(GREATEST(daily_newest, $2), $2)
            WHERE asset_id = $1 AND data_vendor_id = (SELECT id FROM data_vendor WHERE key = 'massive')
