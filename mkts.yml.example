root_directory: data
listen_port: 5993
grpc_listen_port: 5995
log_level: info
stop_grace_period: 0
wal_rotate_interval: 5
timezone: "America/New_York"

# attrgroup_types defines schema templates for attribute groups.
# When a bucket is created with a matching attrgroup name (e.g., AAPL/1Min/OHLCV),
# the configured schema is used as the default. This ensures consistent data types
# across all buckets of the same type.
#
# Behavior:
# - Columns defined here use the configured types
# - Extra columns from feeders are kept with their inferred types (with a warning)
# - If a feeder sends a column with an incompatible type, an error is raised
# - record_type can be "fixed" (default) or "variable"
#
# Supported column types:
#   float32, float64, int16, int32, int64,
#   uint8, uint16, uint32, uint64, byte, bool, string16
#
attrgroup_types:
  OHLCV:
    columns:
      Open: float32
      High: float32
      Low: float32
      Close: float32
      Volume: int64
    record_type: fixed

  # TRADE - Individual trade executions (used by models/trade.go and massive plugin)
  # Full trade data with exchange, tape ID, and up to 4 condition codes
  TRADE:
    columns:
      Nanoseconds: int32
      Price: float64
      Size: uint64
      Exchange: byte
      TapeID: byte
      Cond1: byte
      Cond2: byte
      Cond3: byte
      Cond4: byte
    record_type: variable

  # TICK - Simplified tick data (used by xignitefeeder, alpacabkfeeder)
  # Contains combined quote + trade snapshot with OHLCV for the period
  # Schema varies by feeder; this is the xignitefeeder schema:
  TICK:
    columns:
      Ask: float32
      AskSize: float32
      Bid: float32
      BidSize: float32
      Last: float32
      LastSize: float32
      DateTime: int64
      Open: float32
      High: float32
      Low: float32
      Close: float32
      Volume: int64
      PreviousClose: float32
    record_type: fixed

  QUOTE:
    columns:
      Nanoseconds: int32
      BidPrice: float64
      AskPrice: float64
      BidSize: uint64
      AskSize: uint64
    record_type: variable

triggers:
  - module: stream.so
    on: "*/1Sec/*"
    config:
      filter: "nasdaq"

  - module: stream.so
    on: "*/1Min/*"
    config:
      filter: "nasdaq"

  # Stage 1: TRADE -> 1Sec OHLCV bars
  - module: ondiskagg.so
    on: "*/1Sec/TRADE"
    config:
      destinations:
        - 1Sec

  # Stage 2: 1Sec -> 1Min OHLCV bars
  - module: ondiskagg.so
    on: "*/1Sec/OHLCV"
    config:
      destinations:
        - 1Min

  # Stage 3: 1Min -> 1D OHLCV bars
  - module: ondiskagg.so
    on: "*/1Min/OHLCV"
    config:
      destinations:
        - 1D

bgworkers:
  - module: massive.so
    name: Massive
    config:
      api_key: "FIXME"
      base_url: "https://api.massive.com"
      ws_server: "wss://socket.massive.com"  # "wss://delayed.massive.com/stocks" | "ws://127.0.0.1:8765"
      # ws_data_types controls real-time WebSocket streaming.
      ws_data_types:
        - quotes
        - trades
        - 1Sec
        - 1Min  # default if none specified
      symbols:
        - AAPL
        - SPY
      # query_start controls backfill independently of streaming.
      # Keys can be quotes, trades, or timeframes (eg 1Min, 5Min, 1H, 1D)
      query_start:
#        quotes: "2024-01-01"
#        trades: "2024-01-01"
        1Min: "2024-01-01"
        1D: "2024-01-01"
      backfill_batch_size: 50000
      backfill_adjusted: true
